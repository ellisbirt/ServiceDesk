{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft.AspNetCore": "Warning", "System.Net.Http.HttpClient": "Warning" }
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "UseDevAuth": false,
    "Enforce": false,
    "Authority": "",
    "Audience": "",
    "SpaClientId": "",
    "ApiScope": ""
  },
  "Cors": { "AllowedOrigins": [] },
  "Storage": { "Provider": "InMemory" },
  "Cosmos": {
    "Endpoint": "",
    "Database": "agentdesk",
    "EnableVectorPolicy": true,
    "EmbeddingDimensions": 1536
  },
  "Blobs": { "Provider": "InMemory", "Container": "ticket-attachments" },
  "Intake": { "Provider": "None", "QueueName": "private-corp-tickets" },
  "Llm": {
    "Roles": {
      "assist": { "Provider": "offline", "Model": "offline-assist", "MaxTokens": 2048 },
      "embedding": { "Provider": "offline", "Model": "offline-embedding", "Dimensions": 1536 }
    }
  },
  "RateLimit": { "AssistPerMinute": 20, "HubTicketPerMinute": 30 }
}
