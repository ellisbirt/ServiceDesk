# Copy to .env.local (dev) or .env.production.local (build). Never commit real values.

# Leave empty to call the API on the same origin (the Vite dev server proxies /api, /hubs and /dev-blobs to :5139).
VITE_API_BASE_URL=

# Microsoft Entra ID sign-in. Leave all three empty for local dev auth (X-Dev-* headers, dev server only).
# A production build fails if any is missing.
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_AUTHORITY=https://login.microsoftonline.com/<tenant-id>
VITE_API_SCOPE=api://<api-app-id>/access_as_user
