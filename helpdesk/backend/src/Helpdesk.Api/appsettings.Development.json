{
  "Auth": {
    "UseDevAuth": true
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Queue": {
    "Provider": "StorageQueue"
  },
  "StorageQueue": {
    "ConnectionString": "UseDevelopmentStorage=true"
  },
  "Kb": {
    "MinSimilarity": 0.1,
    "Cosmos": {
      "AllowInsecureEmulatorCertificate": true
    }
  },
  "Llm": {
    "Roles": {
      "embedding": { "Provider": "offline", "Model": "offline-embedding", "Dimensions": 1536 }
    }
  }
}
